{
  "name": "@auram/launcher",
  "productName": "Auram Launcher",
  "version": "0.1.1",
  "private": true,
  "description": "Desktop launcher for the Auram creative application ecosystem.",
  "license": "Apache-2.0",
  "author": "Auram contributors",
  "homepage": "https://github.com/deziemniakv/Auram-Launcher",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "node ../../scripts/generate-licenses.mjs && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "test:e2e": "playwright test",
    "package:win": "pnpm run build && electron-builder --win --publish never",
    "package:dir": "pnpm run build && electron-builder --dir --publish never"
  },
  "dependencies": {
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@auram/app-manifest": "workspace:*",
    "@auram/design-tokens": "workspace:*",
    "@auram/project-format": "workspace:*",
    "@auram/ui": "workspace:*",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.9.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~6.0.3",
    "vite": "^7.3.7",
    "yazl": "^3.3.1",
    "zod": "^4.6.6",
    "zustand": "^5.0.15"
  }
}
